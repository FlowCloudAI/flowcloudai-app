{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "流云AI",
  "version": "0.1.4",
  "identifier": "cn.flowcloudai.www",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "流云AI",
        "label": "main",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "windowEffects": {
          "effects": ["acrylic"]
        },
        "center": true,
        "additionalBrowserArgs": "--disable-extensions --disable-background-networking --disable-sync --metrics-recording-only --disable-component-update --disable-default-apps --disable-domain-reliability --no-first-run --disable-features=Spellcheck,AutofillServerCommunication,Translate,AudioServiceOutOfProcess --proxy-bypass-list=*.localhost"      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; img-src 'self' data: fcimg: http://fcimg.localhost https://www.flowcloudai.cn",
      "capabilities": [
        "default",
        "desktop-lifecycle"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "16.2",
      "template": "src-tauri/ios/project.yml"
    },
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/templates": "templates",
      "icons/fcplug.ico": "icons/fcplug.ico",
      "icons/fcworld.ico": "icons/fcworld.ico"
    },
    "licenseFile": "nsis/license.rtf",
    "fileAssociations": [
      {
        "ext": ["fcplug"],
        "contentTypes": ["cn.flowcloudai.fcplug"],
        "mimeType": "application/x-fcplugin",
        "description": "流云AI插件文件",
        "role": "Editor",
        "name": "FlowCloudAI Plugin"
      },
      {
        "ext": ["fcworld"],
        "contentTypes": ["cn.flowcloudai.fcworld"],
        "mimeType": "application/x-fcworld",
        "name": "FlowCloudAI 世界观包",
        "description": "FlowCloudAI world export",
        "role": "Editor"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "startMenuFolder": "流云AI",
        "minimumWebview2Version": "110.0.1531.0",
        "installerHooks": "nsis/installer-hooks.nsh",
        "sidebarImage": "icons/sidebarImage.bmp"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libssl3"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGOTc5QkIzRjkyNTA3OTEKUldTUkJ5WDVzNXVYL3lhTWU0U0ZHRHpaTGxJYXdBNXhxNUhsQ1oreHBxMUFReldrdy93Mkt0Q0sK",
      "endpoints": [
        "https://www.flowcloudai.cn/api/v1/app-updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
