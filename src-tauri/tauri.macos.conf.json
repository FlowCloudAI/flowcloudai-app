{
  "app": {
    "windows": [
      {
        "title": "流云AI",
        "label": "main",
        "create": false,
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "zoomHotkeysEnabled": false,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "followsWindowActiveState"
        },
        "trafficLightPosition": {
          "x": 16,
          "y": 26
        },
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "resources": {
      "icons/fcplug.icns": "fcplug.icns",
      "icons/fcworld.icns": "fcworld.icns"
    },
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.3",
      "hardenedRuntime": true,
      "infoPlist": "Info.macos.plist"
    }
  }
}
