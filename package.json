{
  "name": "flowcloudai_app",
  "private": true,
  "version": "0.1.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:ai-conversation-draft": "node --test --experimental-test-isolation=none ./scripts/ai-conversation-state.test.ts",
    "test:ai-continuation": "node --test --experimental-test-isolation=none ./scripts/ai-continuation.test.ts",
    "test:roleplay-tts": "node --test --experimental-test-isolation=none ./scripts/roleplay-tts.test.ts",
    "test:entry-tab-mounting": "node --test --experimental-test-isolation=none ./scripts/entry-tab-mounting.test.ts",
    "test:default-cover": "node --test --experimental-test-isolation=none ./scripts/default-cover.test.ts",
    "test:entry-map-binding": "node --test --experimental-strip-types ./src/features/maps/components/entryMapBinding.test.mjs",
    "test:map-preview-markers": "node --test --experimental-strip-types ./src/features/maps/components/MapShapeEditor/previewMarkers.test.mjs",
    "test:world-check-task": "node --test --experimental-test-isolation=none ./scripts/world-check-task-state.test.ts",
    "test:app-update-policy": "node --experimental-strip-types ./scripts/app-update-policy.test.ts",
    "test:edge-geometry": "node ./scripts/check-edge-geometry.ts",
    "test:markdown-wiki-link-highlight": "node --experimental-strip-types ./scripts/markdown-wiki-link-highlight.test.mjs",
    "test:entry-markdown-toolbar": "node --experimental-strip-types ./scripts/entry-markdown-toolbar.test.mjs",
    "test:entry-editor-reliability": "node --experimental-strip-types ./scripts/entry-editor-reliability.test.mjs",
    "test:entry-markdown-search": "node --experimental-strip-types ./scripts/entry-markdown-search.test.mjs",
    "test:entry-markdown-outline": "node --experimental-strip-types ./scripts/entry-markdown-outline.test.mjs",
    "test:entry-draft-recovery": "node --experimental-strip-types ./scripts/entry-draft-recovery.test.mjs",
    "test:mobile-edge-back": "node --test --experimental-strip-types ./src/app/mobile/mobileEdgeBackGesture.test.mjs ./src/app/mobile/mobilePageTransition.test.mjs",
    "test:mobile-shell": "node --test --experimental-strip-types ./src/app/mobile/mobileInputMode.test.mjs ./src/app/mobile/mobileAccessibility.test.mjs ./src/app/mobile/mobileTypography.test.mjs ./src/app/mobile/mobileUiBaseline.test.mjs",
    "test:mobile-typography": "node --test ./src/app/mobile/mobileTypography.test.mjs",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:windows:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-windows-signed.ps1",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "macos:doctor": "node ./scripts/macos-workflow.mjs doctor",
    "macos:dev": "node ./scripts/macos-workflow.mjs dev",
    "macos:build:debug": "node ./scripts/macos-workflow.mjs build-debug",
    "macos:build:local": "node ./scripts/macos-workflow.mjs build-local",
    "macos:build:release": "node ./scripts/macos-workflow.mjs build-release",
    "ios:doctor": "node ./scripts/ios-workflow.mjs doctor",
    "ios:init": "node ./scripts/ios-workflow.mjs init",
    "ios:sync-icons": "node ./scripts/ios-workflow.mjs sync-icons",
    "ios:dev": "node ./scripts/ios-workflow.mjs dev",
    "ios:run": "node ./scripts/ios-workflow.mjs run",
    "ios:archive": "node ./scripts/ios-workflow.mjs archive",
    "ios:build:debug": "node ./scripts/ios-workflow.mjs build-debug",
    "ios:build:release-test": "node ./scripts/ios-workflow.mjs build-release-test",
    "ios:build:appstore": "node ./scripts/ios-workflow.mjs build-appstore",
    "ios:build:sim:debug": "node ./scripts/ios-workflow.mjs assert-generated && node ./scripts/prepare-ios-build-output.mjs arm64-sim && tauri ios build --debug --target aarch64-sim",
    "android:dev": "node ./scripts/android-dev.cjs",
    "android:dev:device": "node ./scripts/android-dev.cjs --physical-only",
    "android:build:dev": "node ./scripts/android-build.cjs dev",
    "android:build:release": "node ./scripts/android-build.cjs release",
    "android:build:apk": "tauri android build --apk",
    "android:sign:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sign-android-apk.ps1",
    "android:build:signed:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sign-android-apk.ps1 -Build",
    "android:build:debug:x86_64": "set \"CARGO_PROFILE_DEV_DEBUG=0\" && set \"CARGO_PROFILE_DEV_STRIP=debuginfo\" && npm run tauri -- android build --debug --apk --target x86_64"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@pixi/react": "^8.0.5",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-md-editor": "^4.0.11",
    "@use-gesture/react": "^10.3.1",
    "@xyflow/react": "^12.10.2",
    "classnames": "^2.5.1",
    "flowcloudai-ui": "file:../lib_ui/ui",
    "html-to-image": "^1.11.13",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "pixi.js": "^8.18.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^17.0.2",
    "refractor": "^5.0.0",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.9.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.1",
    "baseline-browser-mapping": "^2.10.12",
    "esbuild-wasm": "^0.28.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.3.5"
  },
  "overrides": {
    "dompurify": "^3.4.2"
  }
}
